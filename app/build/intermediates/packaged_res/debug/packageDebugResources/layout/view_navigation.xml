<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="5dp"
    android:background="@color/white">
    <Button android:id="@+id/navPantry" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="48dp"
        android:text="Pantry" android:textAllCaps="false"/>
    <Button android:id="@+id/navRecipes" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="48dp"
        android:text="Recipes" android:textAllCaps="false"/>
    <Button android:id="@+id/navSettings" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="48dp"
        android:text="Settings" android:textAllCaps="false"/>
</LinearLayout>
